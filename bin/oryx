#!/usr/bin/env python3
"""Invoke the Oryx installation from any working directory."""
from pathlib import Path
import json
import runpy
import sys

core = Path(__file__).resolve().parents[1]
sys.dont_write_bytecode = True
sys.path.insert(0, str(core / "src"))
if sys.argv[1:2] == ["recovery"]:
    sys.argv.pop(1)
    runpy.run_module("oryx.recovery", run_name="__main__", alter_sys=True)
elif sys.argv[1:2] == ["resource"]:
    if len(sys.argv) != 3:
        sys.exit("Usage: oryx resource 'oryx://core/path[#anchor]'")
    sys.path.insert(0, str(core / "tools"))
    from oryx.workspace.resources import CoreResources
    from conversion import markdown_anchors
    try:
        print(json.dumps(CoreResources(core).resolve(sys.argv[2], markdown_anchors)))
    except (OSError, ValueError) as exc:
        sys.exit(str(exc))
else:
    sys.path.insert(0, str(core / "tools"))
    runpy.run_path(str(core / "tools/pm.py"), run_name="__main__")
